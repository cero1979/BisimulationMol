# ---------------------------------------------------------------------------
# Track only the revised NetMAHIB manuscript source. Older journal versions and
# local LaTeX build products remain outside version control.
# ---------------------------------------------------------------------------
paper/*
!paper/netmahib/
paper/netmahib/*
!paper/netmahib/main.tex
!paper/netmahib/references.bib
!paper/netmahib/sn-jnl.cls
!paper/netmahib/sn-mathphys-ay.bst
!paper/jmcs/
paper/jmcs/*
!paper/jmcs/*.tex
!paper/jmcs/*.bib
!paper/jmcs/*.md
!paper/jmcs/resources/
!paper/jmcs/resources/ISRP.cls
!paper/jmcs/resources/jmcs.jpg

# Elsevier LaTeX template bundle (only used to typeset the manuscript)
els-cas-templates/
els-cas-templates.zip

# Any PDF (base article, compiled manuscript, exported figures, ...)
*.pdf

# Regenerated figures: produced deterministically by `make figures`
figs/
tmp/

# Locally generated submission bundles and superseded BioSystems packages.
submission/biosystems_*/
submission/netmahib_latex_flat/
submission/netmahib_latex_flat.zip
submission/netmahib_reproducibility.zip

# Clean JMCS delivery directory. Explicit source and final-package exceptions
# are declared after the generic LaTeX/PDF exclusions below.
submission_jmcs/*

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/
.pytest_cache/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.DS_Store
.vscode/
.idea/

# ---------------------------------------------------------------------------
# Stray LaTeX auxiliaries (in case a .tex is ever compiled inside the repo)
# ---------------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
build*.log

!paper/jmcs/main.pdf
!submission_jmcs/main.tex
!submission_jmcs/references.bib
!submission_jmcs/main.pdf
!submission_jmcs/resources/
!submission_jmcs/resources/ISRP.cls
!submission_jmcs/resources/jmcs.jpg
!submission_jmcs/figures/
!submission_jmcs/figures/*.pdf
!submission_jmcs/JMCS_submission.zip
