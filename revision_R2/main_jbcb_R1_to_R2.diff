-\begin{equation}\label{eq:late-choice}
- \ell_0\xrightarrow{a}\ell_1,\qquad
- \ell_1\xrightarrow{b}\ell_b,\qquad
- \ell_1\xrightarrow{c}\ell_c,
-\end{equation}
